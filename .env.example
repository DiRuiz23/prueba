# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO  (copiar a ".env" y completar)
#
#   copy .env.example .env      (Windows)     |     cp .env.example .env
#
# - ".env" está en .gitignore: NUNCA lo subas al repositorio.
# - La aplicación lo carga automáticamente si está en el directorio de trabajo
#   (spring.config.import=optional:file:./.env[.properties]).
# - En despliegue (Render, Docker, etc.) define estas mismas variables en el
#   panel del entorno / gestor de secretos; no uses archivos.
# - Todas son OBLIGATORIAS: si falta alguna la aplicación no arranca (fail-fast).
# =====================================================================

# --- Base de datos PostgreSQL ---
SPRING_DATASOURCE_PASSWORD=<password-de-postgres>

# --- Seguridad JWT (mínimo 32 caracteres aleatorios) ---
BANCO_JWT_SECRET=<secreto-jwt-aleatorio-de-al-menos-32-caracteres>

# --- GestoPago: autenticación (authenticate) ---
GESTOPAGO_AUTH_PASSWORD=<password-del-dispositivo-gestopago>

# --- GestoPago: transacciones (sendTx / confirmTx) ---
# Llave e IV AES-256 en Base64 entregados por el proveedor
GESTOPAGO_TX_SECRET_KEY=<llave-aes-base64>
GESTOPAGO_TX_IV=<iv-aes-base64>
GESTOPAGO_TX_API_KEY=<x-api-key-entregada-por-el-proveedor>
